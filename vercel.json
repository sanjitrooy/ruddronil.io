{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/customer-dashboard", "destination": "/customer-dashboard.html" },
    { "source": "/work-tracking", "destination": "/work-tracking.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/reviews", "destination": "/reviews.html" }
  ]
}
