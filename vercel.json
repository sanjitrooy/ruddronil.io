{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/public/sitemap.xml" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/customer-dashboard", "dest": "/customer-dashboard.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/work-tracking", "dest": "/work-tracking.html" },
    { "src": "/portfolio", "dest": "/portfolio.html" },
    { "src": "/reviews", "dest": "/reviews.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
